    "BuildingBlocks": { "revision": "@BALLANCE_BUILDING_BLOCKS_REVISION@", "dirty": @BALLANCE_BUILDING_BLOCKS_DIRTY@ },
    "Plugins": { "revision": "@BALLANCE_PLUGINS_REVISION@", "dirty": @BALLANCE_PLUGINS_DIRTY@ },
    "ParameterOperations": { "revision": "@BALLANCE_PARAMETER_OPERATIONS_REVISION@", "dirty": @BALLANCE_PARAMETER_OPERATIONS_DIRTY@ },
    "SdlInputManager": { "revision": "@BALLANCE_SDL_INPUT_MANAGER_REVISION@", "dirty": @BALLANCE_SDL_INPUT_MANAGER_DIRTY@ },
    "SdlSoundManager": { "revision": "@BALLANCE_SDL_SOUND_MANAGER_REVISION@", "dirty": @BALLANCE_SDL_SOUND_MANAGER_DIRTY@ }
  },
  "recursiveSubmodules": [
